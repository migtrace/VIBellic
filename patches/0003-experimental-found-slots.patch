 /// How often [`BUFFERS`] was taken to be changed.
 static BUFFERS_CHANGED: AtomicU64 = AtomicU64::new(1);
 
-/// Answers a thread remembers.
+/// Answers a thread remembers by default (`VICTORY_FOUND_SLOTS` changes it).
 const FOUND_MOST: usize = 1024;
 
+/// The most answers `VICTORY_FOUND_SLOTS` may ask a thread to remember.
+const FOUND_SLOTS_MOST: usize = 65_536;
+
+/// `VICTORY_FOUND_SLOTS=<n>` (VIBellic experiment, off unless set): how many
+/// answers each thread remembers in [`FOUND`], a power of two from 1,024 to
+/// 65,536; unset or anything else keeps 1,024, the slots and the hash exactly
+/// as before. More slots mean fewer different asks sharing one; what is
+/// remembered and when it stops counting ([`BUFFERS_CHANGED`]) is unchanged.
+/// The idea is VIctory-Fast's (maren-halv/VIctory-Fast e0e549a2, GPL-3.0:
+/// 8,192 there "without conflict thrashing"); read once.
+fn found_slots() -> usize {
+    static SLOTS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *SLOTS.get_or_init(|| {
+        let spec = std::env::var("VICTORY_FOUND_SLOTS").ok();
+        let slots = parse_found_slots(spec.as_deref());
+        if spec.is_some() {
+            tracing::info!(slots, "VICTORY_FOUND_SLOTS: answers each recording thread remembers");
+        }
+        slots
+    })
+}
+
+/// `VICTORY_FOUND_SLOTS`'s value: a power of two in 1,024..=65,536, else 1,024.
+fn parse_found_slots(spec: Option<&str>) -> usize {
+    spec.and_then(|s| s.trim().parse::<usize>().ok())
+        .filter(|n| n.is_power_of_two() && (FOUND_MOST..=FOUND_SLOTS_MOST).contains(n))
+        .unwrap_or(FOUND_MOST)
+}
+
+/// The slot of an ask among `slots` (a power of two): the hash's top bits, so
+/// that 1,024 slots give the slot they always had (the top 10 bits).
+fn found_index(address: u64, len: u64, slots: usize) -> usize {
+    let h = (address ^ len.rotate_left(32)).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+    (h >> (64 - slots.trailing_zeros())) as usize
+}
+
 /// An ask (address, bytes), the count of changes it was answered at, and the
 /// answer.
