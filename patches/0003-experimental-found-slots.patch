     });
 }
 
+#[cfg(test)]
+mod found_slot_tests {
+    use super::*;
+
+    #[test]
+    fn found_slots_take_only_powers_of_two_in_range() {
+        assert_eq!(parse_found_slots(None), 1024, "unset: as before");
+        assert_eq!(parse_found_slots(Some("8192")), 8192);
+        assert_eq!(parse_found_slots(Some(" 4096 ")), 4096, "spaces");
+        assert_eq!(parse_found_slots(Some("65536")), 65_536, "the most");
+        assert_eq!(parse_found_slots(Some("1024")), 1024);
+        assert_eq!(parse_found_slots(Some("1000")), 1024, "not a power of two");
+        assert_eq!(parse_found_slots(Some("512")), 1024, "fewer than before");
+        assert_eq!(parse_found_slots(Some("131072")), 1024, "past the most");
+        assert_eq!(parse_found_slots(Some("0")), 1024);
+        assert_eq!(parse_found_slots(Some("-8192")), 1024);
+        assert_eq!(parse_found_slots(Some("lots")), 1024);
+        assert_eq!(parse_found_slots(Some("")), 1024);
+    }
+
+    /// 1,024 slots: the slot of every ask is the one the old `found_at` gave.
+    #[test]
+    fn default_slots_index_as_before() {
+        let old = |address: u64, len: u64| {
+            let h = (address ^ len.rotate_left(32)).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+            (h >> 54) as usize % 1024
+        };
+        let mut x = 0x1234_5678_9abc_def0_u64;
+        for _ in 0..100_000 {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            let (address, len) = (x & 0x0000_7fff_ffff_fff0, (x >> 40) & 0xf_ffff);
+            assert_eq!(found_index(address, len, 1024), old(address, len));
+        }
+    }
+
+    #[test]
+    fn every_slot_count_indexes_inside_its_table_and_spreads() {
+        for slots in [1024usize, 2048, 8192, 65_536] {
+            let mut used = vec![false; slots];
+            for i in 0..(slots as u64 * 4) {
+                let at = found_index(0x2000_0000 + i * 256, 256, slots);
+                assert!(at < slots, "{slots}: {at}");
+                used[at] = true;
+            }
+            let share = used.iter().filter(|u| **u).count() as f64 / slots as f64;
+            assert!(share > 0.9, "{slots} slots: only {share:.2} used by 4x as many buffers");
+        }
+    }
+
+    /// A remembered answer stops counting when the map changes, whatever the
+    /// slot count (the count is part of what is remembered, not of the slot).
+    #[test]
+    fn a_changed_map_is_not_answered_from_memory_at_any_slot_count() {
+        for slots in [1024usize, 8192] {
+            let mut table: Vec<(u64, u64, u64)> = vec![(0, 0, 0); slots];
+            let (address, len, changed) = (0x4000_0000_u64, 4096_u64, 7_u64);
+            table[found_index(address, len, slots)] = (address, len, changed);
+            let hit = |now: u64| table[found_index(address, len, slots)] == (address, len, now);
+            assert!(hit(7));
+            assert!(!hit(8), "{slots}: a change must miss");
+        }
+    }
+}
